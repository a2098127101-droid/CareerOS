# CareerOS v1.0-beta1 staging certification environment
# Copy to deploy/.env.staging and replace every CHANGE_ME value before external access.
APP_ENV=staging
DEMO_MODE=false
AUTH_REQUIRED=true
ALLOW_SELF_REGISTRATION=false
APP_SECRET_KEY=CHANGE_ME_64_CHAR_RANDOM_SECRET
ADMIN_TOKEN=
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
PUBLIC_BASE_URL=http://127.0.0.1:8000

REPOSITORY_BACKEND=postgresql
DATABASE_URL=postgresql://careeros:CHANGE_ME_DB_PASSWORD@postgres:5432/careeros
POSTGRES_DB=careeros
POSTGRES_USER=careeros
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_CERTIFICATION_FILE=/app/data/postgres_certification.json
RUNTIME_CERTIFICATION_FILE=/app/data/runtime_certification.json
RUNTIME_CERTIFICATION_MAX_AGE_HOURS=24

RUNTIME_STATE_BACKEND=redis
REDIS_URL=redis://redis:6379/0
BACKGROUND_JOB_BACKEND=redis
BACKGROUND_JOB_WORKERS=2

STORAGE_PROVIDER=s3
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_CERTIFICATION_FETCH_ENDPOINT=http://minio:9000
S3_BUCKET=careeros-private
S3_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS
S3_SECRET_KEY=CHANGE_ME_MINIO_SECRET
S3_REGION=us-east-1
MINIO_ROOT_USER=CHANGE_ME_MINIO_ACCESS
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_SECRET

# Replace with a real semantic embedding provider for full certification.
EMBEDDING_PROVIDER=local_hash
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=local-hash-v1
EMBEDDING_DIMENSIONS=256

# Configure at least one real generation provider through env/bootstrap or Admin Model Center.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@example.invalid
SMTP_HOST=CHANGE_ME_SMTP_HOST
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

PII_REDACTION_ENABLED=true
BILLING_ENABLED=false
BILLING_PROVIDER=mock
AUTO_SEED_DEMO_USERS=false
BOOTSTRAP_SUPERADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_SUPERADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
BUSINESS_CERTIFICATION_FILE=/app/data/business_certification.json
BUSINESS_CERTIFICATION_MAX_AGE_HOURS=24
# Set this to a real monitoring/collector health endpoint before full runtime certification.
OBSERVABILITY_CERTIFICATION_URL=
