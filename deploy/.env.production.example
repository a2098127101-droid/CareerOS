# CareerOS production environment
# Copy to deploy/.env.production and replace every CHANGE_ME value.
# Never commit deploy/.env.production.

APP_ENV=production
DEMO_MODE=false
AUTH_REQUIRED=true
ALLOW_SELF_REGISTRATION=false
AUTO_SEED_DEMO_USERS=false
COOKIE_SECURE=true
SESSION_TTL_HOURS=168
APP_SECRET_KEY=CHANGE_ME_64_CHAR_RANDOM_SECRET
ADMIN_TOKEN=
PRODUCT_NAME=CareerOS
PRODUCT_PRESET=career_development
BOOTSTRAP_TENANT_ID=production-org
BOOTSTRAP_TENANT_NAME=CareerOS Production Organization
BOOTSTRAP_SUPERADMIN_EMAIL=admin@example.com
BOOTSTRAP_SUPERADMIN_PASSWORD=CHANGE_ME_STRONG_BOOTSTRAP_PASSWORD

DOMAIN=careeros.example.com
STORAGE_DOMAIN=storage.careeros.example.com
ACME_EMAIL=admin@careeros.example.com
PUBLIC_BASE_URL=https://careeros.example.com
ALLOWED_ORIGINS=https://careeros.example.com

REPOSITORY_BACKEND=postgresql
SCHEMA_BOOTSTRAP_MODE=alembic
POSTGRES_DB=careeros
POSTGRES_OWNER_USER=careeros_owner
POSTGRES_OWNER_PASSWORD=CHANGE_ME_POSTGRES_OWNER_PASSWORD
POSTGRES_APP_USER=careeros_app
POSTGRES_APP_PASSWORD=CHANGE_ME_POSTGRES_APP_PASSWORD
# URL-encode reserved characters in passwords before placing them in these URLs.
OWNER_DATABASE_URL=postgresql://careeros_owner:CHANGE_ME_URL_ENCODED_OWNER_PASSWORD@postgres:5432/careeros
DATABASE_URL=postgresql://careeros_app:CHANGE_ME_URL_ENCODED_APP_PASSWORD@postgres:5432/careeros
POSTGRES_CERTIFICATION_FILE=/app/data/postgres_certification.json

RUNTIME_STATE_BACKEND=redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_URL_ENCODED_REDIS_PASSWORD@redis:6379/0
BACKGROUND_JOB_BACKEND=redis
BACKGROUND_JOB_WORKERS=2
BACKGROUND_JOB_TTL_SECONDS=86400
BACKGROUND_JOB_MAX_ATTEMPTS=3

STORAGE_PROVIDER=s3
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://storage.careeros.example.com
S3_CERTIFICATION_FETCH_ENDPOINT=http://minio:9000
S3_BUCKET=careeros-private
S3_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
S3_REGION=us-east-1
MINIO_ROOT_USER=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_SECRET_KEY
MINIO_CONSOLE_PORT=9001
FILE_SIGNED_URL_TTL_SECONDS=900
MAX_UPLOAD_BYTES=12582912
UPLOAD_MAX_ARCHIVE_ENTRIES=5000
UPLOAD_MAX_ARCHIVE_UNCOMPRESSED_BYTES=104857600
UPLOAD_MAX_ARCHIVE_RATIO=100
MALWARE_SCAN_COMMAND=

EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=CHANGE_ME_EMBEDDING_BASE_URL
EMBEDDING_API_KEY=CHANGE_ME_EMBEDDING_API_KEY
EMBEDDING_MODEL=CHANGE_ME_EMBEDDING_MODEL
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_BATCH_SIZE=64
EMBEDDING_MAX_RETRIES=2

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
LLM_RETRY_ATTEMPTS=2
LLM_RETRY_BACKOFF_SECONDS=0.8
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_COOLDOWN_SECONDS=60

EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@careeros.example.com
SMTP_HOST=CHANGE_ME_SMTP_HOST
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_SMTP_USERNAME
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20

PII_REDACTION_ENABLED=true
PRIVACY_DELETE_EXECUTOR_ENABLED=false
BILLING_ENABLED=false
BILLING_PROVIDER=mock
BILLING_WEBHOOK_SECRET=

SENTRY_DSN=
OTEL_SERVICE_NAME=careeros-api
OBSERVABILITY_CERTIFICATION_URL=CHANGE_ME_OBSERVABILITY_HEALTH_URL
JSON_LOGS=true
RUNTIME_CERTIFICATION_FILE=/app/data/runtime_certification.json
RUNTIME_CERTIFICATION_MAX_AGE_HOURS=24
BUSINESS_CERTIFICATION_FILE=/app/data/business_certification.json
BUSINESS_CERTIFICATION_MAX_AGE_HOURS=24
