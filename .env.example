# ===== CareerOS environment =====
# development | staging | production
APP_ENV=development
DEMO_MODE=true
PRODUCT_NAME=CareerOS
# career_development | campus_career | career_competition | career_service | enterprise_talent
PRODUCT_PRESET=career_development

# Repository backend. SQLite remains the local compatibility runtime; PostgreSQL is required for non-demo production.
REPOSITORY_BACKEND=sqlite
SCHEMA_BOOTSTRAP_MODE=legacy
APP_DB_PATH=data/agent.db
# Example production URL: postgresql://user:password@host:5432/careeros
DATABASE_URL=

# ===== Authentication / security =====
AUTH_REQUIRED=false
ALLOW_SELF_REGISTRATION=false
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
ALLOWED_ORIGINS=
APP_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_TOKEN=

BOOTSTRAP_TENANT_ID=demo-org
BOOTSTRAP_TENANT_NAME=CareerOS Demo Organization
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=
AUTO_SEED_DEMO_USERS=true

MAX_UPLOAD_BYTES=12582912
RAG_TOP_K=5
RAG_MAX_CHARS=9000

# ===== LLM reliability =====
LLM_RETRY_ATTEMPTS=2
LLM_RETRY_BACKOFF_SECONDS=0.8
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_COOLDOWN_SECONDS=60

# ===== Semantic embedding provider =====
# local_hash = offline deterministic fallback (not semantic)
# Supported semantic providers use an OpenAI-compatible /embeddings contract:
# openai_compatible | bge_compatible | jina_compatible | private_api
EMBEDDING_PROVIDER=local_hash
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=local-hash-v1
EMBEDDING_DIMENSIONS=256
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_BATCH_SIZE=64
EMBEDDING_MAX_RETRIES=2
EMBEDDING_RETRY_BACKOFF_SECONDS=0.5

# ===== Object storage =====
# local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=data/uploads
# S3-compatible: AWS S3 / Cloudflare R2 / MinIO / compatible providers
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_CERTIFICATION_FETCH_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto


# ===== Distributed runtime / background jobs =====
# development: memory + inprocess
# non-demo production: redis + redis
RUNTIME_STATE_BACKEND=memory
REDIS_URL=
BACKGROUND_JOB_BACKEND=inprocess
BACKGROUND_JOB_WORKERS=2
BACKGROUND_JOB_TTL_SECONDS=86400
BACKGROUND_JOB_MAX_ATTEMPTS=3

# ===== Private file security =====
FILE_SIGNED_URL_TTL_SECONDS=900
UPLOAD_MAX_ARCHIVE_ENTRIES=5000
UPLOAD_MAX_ARCHIVE_UNCOMPRESSED_BYTES=104857600
UPLOAD_MAX_ARCHIVE_RATIO=100
# Optional scanner command. Use {file} placeholder, e.g. clamscan --no-summary {file}
MALWARE_SCAN_COMMAND=

# ===== Observability =====
JSON_LOGS=true
SENTRY_DSN=
OTEL_SERVICE_NAME=careeros-api

# ===== Privacy / data minimization =====
# Defaults to true automatically in APP_ENV=production when unset.
PII_REDACTION_ENABLED=false
# Explicitly enable controlled deletion/de-identification processing after policy review.
PRIVACY_DELETE_EXECUTOR_ENABLED=false

# ===== Billing foundation =====
# alpha8 still implements signed mock/sandbox billing only. Real payment providers are NOT implemented.
BILLING_ENABLED=false
BILLING_PROVIDER=mock
BILLING_WEBHOOK_SECRET=

# ===== Generation model providers =====
# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini

# DeepSeek / any OpenAI-compatible chat completion provider
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=

# Google Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=

# Self-hosted / custom OpenAI-compatible provider
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=http://127.0.0.1:8001/v1
CUSTOM_LLM_MODEL=default
CUSTOM_LLM_NAME=Custom OpenAI-compatible

DEFAULT_LLM_PROVIDER=

# PostgreSQL live repository certification (generated by scripts/certify_postgres.py)
POSTGRES_CERTIFICATION_FILE=data/postgres_certification.json

# ===== Public URL / email delivery =====
PUBLIC_BASE_URL=http://127.0.0.1:8000
# console = local outbox only; smtp = external delivery
EMAIL_PROVIDER=console
EMAIL_FROM=
EMAIL_OUTBOX_PATH=data/email_outbox.jsonl
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20

# Runtime certification report generated by scripts/certify_runtime.py
RUNTIME_CERTIFICATION_FILE=data/runtime_certification.json
RUNTIME_CERTIFICATION_MAX_AGE_HOURS=24

# beta1 business runtime verification gate. Production /ready requires a fresh signed report.
BUSINESS_CERTIFICATION_FILE=data/business_certification.json
BUSINESS_CERTIFICATION_MAX_AGE_HOURS=24
# Optional external monitoring health endpoint used by beta1 runtime certification.
OBSERVABILITY_CERTIFICATION_URL=
