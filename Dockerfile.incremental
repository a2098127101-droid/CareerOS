ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Offline/air-gapped hot update path. This is valid only when requirements.lock is
# unchanged from BASE_IMAGE; deployment automation must verify that invariant.
USER root
COPY --chown=10001:10001 . .
USER 10001:10001

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl --fail --silent http://127.0.0.1:8000/live || exit 1
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
